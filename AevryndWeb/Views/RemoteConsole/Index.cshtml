@model AevryndWeb.Models.RemoteConsoleViewModel
@{ ViewData["Title"] = "遠端控制台"; }
<section class="remote-shell" data-enabled="@(Model.LocallyEnabled ? "true" : "false")" data-active="@(Model.GrantActive ? "true" : "false")" data-capabilities="@string.Join(',', Model.Capabilities)" data-grant-expires="@(Model.GrantExpiresAt?.ToString("O"))">
    <header class="dashboard-head">
        <div><p class="eyebrow"><span></span> REMOTE CONSOLE</p><h1>主電腦遠端工作階段</h1><p>所有能力均由本機短效開關與第二次郵件驗證共同限制。</p></div>
        <a class="button button-quiet" asp-controller="Home" asp-action="Portal">返回控制台</a>
    </header>
    <aside class="remote-safety">
        <strong>@(Model.LocallyEnabled ? "本機短效開關已啟用" : "本機開關為關閉狀態")</strong>
        <span>@(Model.EnabledUntilUtc is null ? "請在主電腦執行 scripts/Enable-RemoteConsole.ps1。重啟或部署後仍預設關閉。" : $"本機期限：{Model.EnabledUntilUtc.Value.ToLocalTime():yyyy-MM-dd HH:mm:ss}")</span>
        <span>允許能力：@(Model.Capabilities.Count == 0 ? "無" : string.Join("、", Model.Capabilities))</span>
        <span id="grantLifetime">@(Model.GrantExpiresAt is null ? "尚未取得網站控制授權" : $"網站授權到期：{Model.GrantExpiresAt.Value.ToLocalTime():yyyy-MM-dd HH:mm:ss}（閒置30分鐘會提早撤銷）")</span>
        <span>桌面狀態：@(Model.DesktopAvailability.Available ? "互動式桌面已就緒" : Model.DesktopAvailability.Reason)</span>
        @if (Model.Capabilities.Contains("browser.input")) { <span>敏感警告：已額外允許 Chrome／Edge 輸入；網站無法可靠辨識瀏覽器內的密碼欄位，操作前必須自行確認目前焦點。</span> }
        <span>緊急停止：在主電腦執行 scripts/Disable-RemoteConsole.ps1。</span>
    </aside>
    <article id="stepUpPanel" class="remote-step" hidden="@(Model.GrantActive ? "hidden" : null)">
        <span class="micro-label">SECOND FACTOR</span><h2>建立短效控制授權</h2>
        <p>輸入本機啟用腳本一次顯示的配對碼，再以 slime12968@gmail.com 收到的控制驗證碼完成授權。</p>
        <form id="pairingForm"><label for="pairingNonce">本機一次配對碼</label><input id="pairingNonce" autocomplete="off" required /><button class="button button-secondary" type="submit" disabled="@(Model.LocallyEnabled ? null : "disabled")">寄送控制驗證碼</button></form>
        <form id="controlCodeForm" hidden><label for="controlCode">控制驗證碼</label><input id="controlCode" minlength="8" maxlength="8" autocomplete="one-time-code" required /><button class="button button-primary" type="submit">啟用短效授權</button></form>
        <p id="stepUpStatus" class="form-status" aria-live="polite"></p>
    </article>
    <div id="remoteWorkspace" class="remote-grid" hidden="@(Model.GrantActive ? null : "hidden")">
        <article id="screenPanel" class="remote-screen-card">
            <div class="remote-screen-head"><span>INTERACTIVE DESKTOP</span><span id="frameStatus">等待畫面</span></div>
            <div class="remote-screen-wrap"><img id="remoteFrame" alt="主電腦目前互動式桌面的低頻快照" draggable="false" hidden /><p id="framePlaceholder">正在建立安全畫面通道…</p></div>
            <p class="remote-hint">若已啟用 mouse.write，可直接點擊畫面；每次操作都必須對應兩秒內的相同畫面版本。</p>
        </article>
        <article id="textPanel" class="remote-input-card">
            <span class="micro-label">INPUT.TEXT</span><h2>傳送文字</h2>
            <p>僅傳送 NFC 正規化的一般 Unicode 文字；控制、隱藏與方向覆寫字元會被拒絕。</p>
            <form id="remoteTextForm"><label for="remoteText">文字內容</label><textarea id="remoteText" maxlength="512" rows="6" autocomplete="off" spellcheck="false" required></textarea><button class="button button-primary" type="submit">傳送至前景視窗</button></form>
            <p id="remoteTextStatus" class="form-status" aria-live="polite"></p>
        </article>
        <article id="keyboardPanel" class="remote-input-card" hidden>
            <span class="micro-label">KEYBOARD.WRITE</span><h2>鍵盤輸入</h2><p>點選下方區域後使用鍵盤。按下與放開會成對追蹤；授權撤銷時釋放本工作階段注入的按鍵。Chrome／Edge 另需本機明確啟用 browser.input。</p>
            <div id="keyboardCapture" class="keyboard-capture" tabindex="0">點此接收鍵盤事件</div><p id="keyboardStatus" class="form-status" aria-live="polite"></p>
        </article>
        <article class="remote-input-card">
            <span class="micro-label">SHELL.EXECUTE</span><h2>Shell</h2><p>目前保持安全關閉。必須先完成獨立低權限 Windows 帳號 broker、固定 pwsh 雜湊、Job Object 與秘密隔離驗證，網站程序不會直接啟動命令。</p>
        </article>
    </div>
    <button id="revokeRemoteGrant" class="button button-quiet remote-stop" type="button" hidden="@(!Model.GrantActive ? "hidden" : null)">立即撤銷此網站控制授權</button>
</section>
@section Scripts { <script src="~/js/remote-console.js" asp-append-version="true"></script> }
