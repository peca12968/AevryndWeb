@model AevryndWeb.Models.OperationsViewModel
@{
    ViewData["Title"] = "主機效能與工作歷程";
    var isAdmin = AevryndWeb.Security.PortalIdentity.IsAdmin(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? string.Empty);
}
@functions {
    private static string Metric(double? value) => value.HasValue ? $"{value.Value:0.0}%" : "unavailable";
    private static string Timestamp(DateTimeOffset? value) => AevryndWeb.Security.PortalTime.Format(value);
    private static string StatusClass(string status, bool stale = false) => stale ? "is-stale" : status switch { "failed" => "is-failed", "blocked" => "is-blocked", "cancelled" => "is-cancelled", _ => "is-current" };
    private static string StatusLabel(string status) => status switch { "working" => "進行中", "completed" => "已完成", "failed" => "未通過", "blocked" => "等待條件", "cancelled" => "已停止", _ => "狀態待確認" };
    private static string HardwareStatusLabel(string status) => status switch { "verified" => "已驗證", "partial" => "部分已驗證", _ => "待採樣" };
}

<section class="operations-shell" data-operations-root data-snapshot-url="@Url.Action("Snapshot", "Operations")">
    <header class="operations-head">
        <div>
            <p class="eyebrow"><span></span> OPERATIONS OBSERVABILITY</p>
            <h1>主機效能與工作歷程</h1>
            <p>主機統籌開發，台中與桃園按需執行 CPU（處理器）／GPU（顯示卡）測試，不再運行副機 AI 或 GitHub 任務輪詢。頁面約每 10 秒重新讀取既有摘要，不代表每台機器都有新採樣。</p>
            <p>資料串接狀態：真實遠端測試收據已寫入資料庫 RemoteTestRuns；下方目前仍由 JSON 摘要供應，尚非資料庫全部任務的即時清單。舊排程、模型欄位與缺少數值不得用來推斷副機正在工作或故障。</p>
        </div>
        @if (isAdmin) { <a class="button button-quiet" asp-controller="Home" asp-action="Portal">返回控制台</a> }
        else { <button id="logoutButton" class="button button-quiet">安全登出</button> }
    </header>

    <div class="operations-source @(Model.SourceAvailable ? "is-available" : "is-unavailable")" data-operations-source role="status" aria-live="polite">
        <div><span class="operations-signal" aria-hidden="true"></span><strong data-source-status>@Model.SourceStatus</strong></div>
        <span>摘要時間：<time data-snapshot-time datetime="@(Model.SnapshotAt?.ToString("O"))">@Timestamp(Model.SnapshotAt)</time> · <span data-poll-status>等待下一次更新</span></span>
    </div>

    <section class="operations-section" aria-labelledby="nodesTitle">
        <div class="operations-title"><div><span class="micro-label">NODE TELEMETRY</span><h2 id="nodesTitle">三台主機效能採樣</h2></div><p>遙測指實際量測的使用率；stale 表示採樣已過期，unavailable 表示沒有可驗證數值。以採樣時間為準，不以畫面刷新時間代替。</p></div>
        <div class="operations-node-grid" data-node-grid>
            @foreach (var node in Model.Nodes)
            {
                <article class="operations-node-card" data-node-id="@node.Id">
                    <header><div><small>@node.Id.ToUpperInvariant()</small><h3>@node.Name</h3></div><span class="operations-badge @(node.Availability == "current" ? "is-current" : node.Availability == "stale" ? "is-stale" : "is-unavailable")" data-node-availability>@node.Availability</span></header>
                    <dl><div><dt>CPU</dt><dd data-node-metric="cpu">@Metric(node.CpuPercent)</dd></div><div><dt>RAM</dt><dd data-node-metric="ram">@Metric(node.RamPercent)</dd></div><div><dt>GPU</dt><dd data-node-metric="gpu">@Metric(node.GpuPercent)</dd></div></dl>
                    <p>採樣：<time data-node-sampled datetime="@(node.SampledAt?.ToString("O"))">@Timestamp(node.SampledAt)</time></p>
                    <p class="operations-diagnostic" data-node-diagnostic>@node.Diagnostic</p>
                </article>
            }
        </div>
    </section>

    <section class="operations-section" aria-labelledby="hardwareTitle">
        <div class="operations-title"><div><span class="micro-label">NODE HARDWARE &amp; CONFIGURATION</span><h2 id="hardwareTitle">主機配備與來源設定</h2></div><p>硬體基本資料與效能採樣分開。主機模型為使用者設定 GPT-6 Astra、中，非執行偵測；副機現為測試資源，不配置長期 AI 代理。下列模型與角色欄位仍可能來自待遷移的舊設定，不代表現行分工。</p></div>
        <div class="operations-hardware-grid" data-hardware-grid>
            @foreach (var hardware in Model.Hardware)
            {
                <article class="operations-hardware-card" data-hardware-id="@hardware.Id">
                    <header><div><small>@hardware.Id.ToUpperInvariant()</small><h3>@hardware.Name</h3></div><span class="operations-badge @(hardware.HardwareStatus == "verified" ? "is-current" : hardware.HardwareStatus == "partial" ? "is-stale" : "is-unavailable")" data-hardware-status data-hardware-declared-status="@hardware.HardwareStatus">@HardwareStatusLabel(hardware.HardwareStatus)</span></header>
                    <p class="hardware-model"><strong data-hardware-field="model">@hardware.Model</strong> · <span data-hardware-field="reasoning">@hardware.Reasoning</span></p>
                    <p class="hardware-role" data-hardware-field="role">@hardware.Role</p>
                    <dl class="hardware-details">
                        <div><dt>CPU</dt><dd data-hardware-field="cpu">@(hardware.Cpu ?? "等待實測")</dd></div>
                        <div><dt>RAM</dt><dd data-hardware-field="ram">@(hardware.Ram ?? "等待實測")</dd></div>
                        <div><dt>GPU</dt><dd data-hardware-field="gpu">@(hardware.Gpu ?? "等待實測")</dd></div>
                        <div><dt>主機板</dt><dd data-hardware-field="motherboard">@(hardware.Motherboard ?? "等待實測")</dd></div>
                        <div><dt>作業系統</dt><dd data-hardware-field="os">@(hardware.Os ?? "等待實測")</dd></div>
                        <div><dt>儲存</dt><dd data-hardware-field="storage">@(hardware.Storage.Count > 0 ? string.Join("；", hardware.Storage) : "等待實測")</dd></div>
                    </dl>
                    <p class="hardware-provenance">模型來源：<span data-hardware-field="modelSource">@hardware.ModelSource</span><br />硬體來源：<span data-hardware-field="source">@hardware.Source</span><br />硬體採樣：<time data-hardware-field="sampledAt" datetime="@(hardware.SampledAt?.ToString("O"))">@Timestamp(hardware.SampledAt)</time></p>
                </article>
            }
        </div>
    </section>

    <section class="operations-section" aria-labelledby="scheduleTitle">
        <div class="operations-title"><div><span class="micro-label">SOURCE TASK SUMMARY</span><h2 id="scheduleTitle">來源工作摘要（資料遷移中）</h2></div><p data-schedule-status>@if (Model.Schedule.LocalScheduleStale) { <span>本機排程資料待更新；舊的非終態工作不列入計數。 </span> }<span>@(Model.Schedule.SourceAvailable ? (Model.Schedule.Stale ? $"來源尚未完成近期核對（{Timestamp(Model.Schedule.ObservedAt)}）；不推測實際執行狀態。" : $"摘要來源已核對，觀測於 {Timestamp(Model.Schedule.ObservedAt)}；不等於測試程序仍在執行。") : "目前沒有可驗證的摘要來源。")</span>@if (Model.Schedule.SourceAvailable && Model.Schedule.VerifiedAt.HasValue) { <span> 來源核對：@Timestamp(Model.Schedule.VerifiedAt)；工作時間依實際事件保留。</span> }@if (!string.IsNullOrEmpty(Model.Schedule.DisplayDiagnostic)) { <span> @Model.Schedule.DisplayDiagnostic</span> }</p></div>
        <div class="operations-schedule-grid" data-schedule-grid>
            @foreach (var node in new[] { (Id: "local", Name: "本機"), (Id: "taichung", Name: "台中"), (Id: "taoyuan", Name: "桃園") })
            {
                var tasks = Model.Schedule.Tasks.Where(task => string.Equals(task.NodeId, node.Id, StringComparison.OrdinalIgnoreCase)).OrderByDescending(task => task.UpdatedAt).ToArray();
                <article class="operations-schedule-card" data-schedule-node="@node.Id">
                    <header><div><small>@node.Id.ToUpperInvariant()</small><h3>@node.Name</h3></div><span class="operations-schedule-count" data-schedule-count>@tasks.Length</span></header>
                    <dl class="operations-schedule-summary"><div><dt>等待</dt><dd data-schedule-count-state="queued">@tasks.Count(task => task.State == "queued")</dd></div><div><dt>已接單</dt><dd data-schedule-count-state="acknowledged">@tasks.Count(task => task.State == "acknowledged")</dd></div><div><dt>執行</dt><dd data-schedule-count-state="running">@tasks.Count(task => task.State == "running")</dd></div><div><dt>等待條件</dt><dd data-schedule-count-state="blocked">@tasks.Count(task => task.State == "blocked")</dd></div><div><dt>待確認</dt><dd data-schedule-count-state="unconfirmed">@tasks.Count(task => task.State == "unconfirmed")</dd></div></dl>
                    <p class="operations-scroll-hint" id="task-scroll-@node.Id" data-schedule-scroll-hint>全部 @tasks.Length 筆 · 清單可上下捲動，展開任務查看詳細內容。</p>
                    <div class="operations-schedule-list" data-schedule-list tabindex="0" role="region" aria-label="@node.Name 來源工作摘要" aria-describedby="task-scroll-@node.Id">
                        @foreach (var task in tasks)
                        {
                            <details class="operations-schedule-task" data-schedule-task-id="@(task.InstanceId ?? task.Id)"><summary><span>@task.Title<br /><small>最近更新：@Timestamp(task.UpdatedAt)</small></span><span class="operations-badge is-@task.State">@((new Dictionary<string, string> { ["queued"] = "等待中", ["acknowledged"] = "已接單", ["running"] = "執行中", ["blocked"] = "等待條件", ["unconfirmed"] = "狀態待確認" }).TryGetValue(task.State, out var stateLabel) ? stateLabel : "狀態待確認")</span></summary><div class="operations-schedule-detail"><p>@task.Description</p><p>原因：@task.Reason.Replace("受阻", "正在等待必要條件")</p><p>依賴：@(task.DependsOn.Count == 0 ? "無" : string.Join("、", task.DependsOn.Select(dependency => Model.Schedule.Catalog.FirstOrDefault(candidate => candidate.Id == dependency)?.Title ?? $"先前任務（{dependency}）")))</p><p>指派：@Timestamp(task.AssignedAt) · 更新：@Timestamp(task.UpdatedAt)</p><small>任務識別：@task.Id · 證據：@task.Evidence</small></div></details>
                        }
                    </div>
                    <p class="operations-empty" data-schedule-empty @(tasks.Length > 0 ? "hidden" : null)>尚無可驗證排程。</p>
                </article>
            }
        </div>
    </section>

    <section class="operations-section" aria-labelledby="engineMilestoneTitle">
        <div class="operations-title"><div><span class="micro-label">VERIFIED ENGINE MILESTONE</span><h2 id="engineMilestoneTitle">已推送引擎完成歷程</h2></div><p>此區只記錄已推送且具明確測試邊界的里程碑，不併入即時節點狀態。</p></div>
        <div class="operations-table-wrap"><table class="operations-table operations-history"><thead><tr><th>里程碑</th><th>來源</th><th>狀態</th><th>驗證</th><th>證據邊界</th></tr></thead><tbody>
            <tr><td data-label="里程碑">Development Ultra GPU truth</td><td data-label="來源">engine commit fff5638</td><td data-label="狀態"><span class="operations-badge is-current">已完成</span></td><td data-label="驗證">fresh 6/6 + hostile 8/8</td><td data-label="證據邊界">實際 D3D12 adapter LUID 綁定 DXGI telemetry；commit 後持續保存 current-epoch observation，rollback 與 epoch reset 不沿用舊證據。第一個 false 是首筆 frame budget（submitted=1、completed=0、timing=0、lastGpuNs=0）。這不是視覺提高證據；Demo 仍為 34 / 100，v1.4 未發布。</td></tr>
            <tr><td data-label="里程碑">Character asset manifest trust</td><td data-label="來源">engine commit f0129d1</td><td data-label="狀態"><span class="operations-badge is-current">已完成</span></td><td data-label="驗證">fresh 2/2 + hostile GO · package blend=0</td><td data-label="證據邊界">固定 manifest trust anchor、handle-relative／reparse 防護與 GLTF／AESKIN／manifest cross-check 已驗證；runtime 只消費 immutable 資產。這不代表角色美術改善；Demo 仍為 34 / 100，v1.4 未發布。</td></tr>
            <tr><td data-label="里程碑">HLOD aggregate proxy＋安全 runtime cache<br /><small><time datetime="2026-09-06T04:44:00+08:00">2026-09-06 04:44 台北時間（UTC+8）</time></small></td><td data-label="來源">engine commit ab976d21c9505a9295be292211a18d8c42db9edc</td><td data-label="狀態"><span class="operations-badge is-current">已完成</span></td><td data-label="驗證">主機＋獨立 hostile fresh 4/4</td><td data-label="證據邊界">30 rock sources／6 clusters 與六 descriptor coverage；cache 使用 pinned handle，拒絕 reparse／hardlink，並具 unique temp、atomic rename、SHA-256、checked overflow。仍缺 OnRender、GPU-side selection、transition pixels 與 real workload；Demo 仍為 34 / 100，v1.4 未發布。</td></tr>
            <tr><td data-label="里程碑">角色 locomotion 完整週期相位驗收<br /><small><time datetime="2026-09-06">2026-09-06 台北時間（UTC+8）</time></small></td><td data-label="來源">engine commit 4b73f0fa77d6f4e117a4b54b225bea697fe65397</td><td data-label="狀態"><span class="operations-badge is-current">已完成</span></td><td data-label="驗證">fresh Release 3 targets · Automation 360/360 · provenance · capture 12/12 · tamper fail-closed</td><td data-label="證據邊界">以完整接觸深度週期的第一諧波取代不穩定的單一最低點；baseline GAP 0.18333334 未通過，修正後 GAP 0.50、DRIFT 0.013、STEP 0.019。manifest／BIN／AESKIN tamper 均 fail-closed。這提升角色動作驗收可靠性，不代表角色外觀完成；Demo 仍為 34 / 100，v1.4 未發布。</td></tr>
        </tbody></table></div>
    </section>

    <section class="operations-section" aria-labelledby="historyTitle">
        <div class="operations-title"><div><span class="micro-label">PAST TASKS</span><h2 id="historyTitle">過往任務：完成與未通過</h2></div><p>此表僅列既有摘要內含結束時間的紀錄，最多 500 筆；不是資料庫全部遠端測試。完成表示該項工作結束，不代表完整 Demo 或視覺分數通過。所有時間以台北時間 UTC+8 顯示。</p></div>
        <p class="operations-empty" data-history-empty @(Model.History.Count == 0 ? null : "hidden")>@(Model.SourceAvailable ? "尚未累積歷程；工作來源必須提供明確結束狀態才會列入。" : $"無法讀取歷程：{Model.SourceStatus}")</p>
        <div class="operations-table-wrap" data-history-wrap @(Model.History.Count == 0 ? "hidden" : null)><table class="operations-table operations-history" data-history-table><thead><tr><th>任務</th><th>類型／主機</th><th>時間軸</th><th>結果</th><th>證據摘要</th></tr></thead><tbody data-history-body>
        @foreach (var item in Model.History)
        {
            <tr><td data-label="任務"><span>@Model.Schedule.WorkTitle(item)</span>@if (Model.Schedule.WorkTitle(item) != item.Name) { <details><summary>任務識別</summary><small>@item.Name</small></details> }</td><td data-label="類型／主機">@item.Type · @item.Host</td><td data-label="時間軸" data-order="@item.StartedAt.ToUnixTimeMilliseconds()">開始 <time datetime="@item.StartedAt.ToString("O")">@Timestamp(item.StartedAt)</time><br />更新 <time datetime="@(item.UpdatedAt?.ToString("O"))">@Timestamp(item.UpdatedAt)</time><br />結束 <time datetime="@(item.EndedAt?.ToString("O"))">@Timestamp(item.EndedAt)</time></td><td data-label="結果"><span class="operations-badge @StatusClass(item.Status)">@StatusLabel(item.Status)</span></td><td data-label="證據摘要">@(item.EvidenceSummary ?? "來源未提供證據摘要。")</td></tr>
        }
        </tbody></table></div>
    </section>
</section>
