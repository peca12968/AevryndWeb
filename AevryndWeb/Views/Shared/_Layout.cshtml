<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#07110f" />
    <meta name="description" content="Aevrynd AI 控制中心，安全協調多節點智慧助理與開發工作。" />
    <title>@ViewData["Title"] · Aevrynd</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/sweetalert2/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">跳至主要內容</a>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>
    <header class="site-header">
        <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Aevrynd 首頁">
            <span class="brand-mark" aria-hidden="true"><span></span></span>
            <span><strong>AEVRYND</strong><small>AI CONTROL SYSTEM</small></span>
        </a>
        <div class="system-state"><span class="state-dot" aria-hidden="true"></span><span>安全通道已啟用</span></div>
    </header>
    <main id="main-content" class="site-main">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <span>© 2026 Aevrynd Intelligence</span>
        <span class="footer-divider" aria-hidden="true"></span>
        <span>私有運算 · 加密連線</span>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/dist/sweetalert2.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
