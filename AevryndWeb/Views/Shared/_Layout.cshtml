<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#07110f" />
    <meta name="description" content="Aevrynd 原生遊戲引擎開發展示、版本演進與按需測試紀錄；以可重現畫面與證據說明目前進度。" />
    <title>@ViewData["Title"] · Aevrynd</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/sweetalert2/dist/sweetalert2.min.css" />
    <link rel="stylesheet" href="~/lib/datatables/datatables.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">跳至主要內容</a>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>
    <header class="site-header">
        <a class="brand" asp-controller="Home" asp-action="Index" aria-label="Aevrynd 首頁">
            <span class="brand-mark" aria-hidden="true"><span></span></span>
            <span><strong>AEVRYND</strong><small>ENGINE DEVELOPMENT</small></span>
        </a>
        <nav class="public-nav" aria-label="主要導覽"><a asp-controller="Home" asp-action="Showcase">開發展示</a><span class="system-state"><span class="state-dot" aria-hidden="true"></span><span>開發展示與測試紀錄</span></span></nav>
    </header>
    <main id="main-content" class="site-main">
        @RenderBody()
    </main>
    <footer class="site-footer">
        <span>© 2026 Aevrynd Engine</span>
        <span class="footer-divider" aria-hidden="true"></span>
        <span>可重現畫面 · 可追溯證據</span>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/dist/sweetalert2.min.js"></script>
    <script src="~/lib/datatables/datatables.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
